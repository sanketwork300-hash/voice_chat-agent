  {
    "scenario_id": "CONV-CORRECTED-DETAIL",
    "service": "iam",
    "variation": "corrected",
    "fixture": [
      {
        "name": "iam_principal",
        "handle": "who",
        "params": {
          "kind": "user",
          "name": "erin",
          "allow": [
            "s3:ListAllMyBuckets"
          ],
          "deny": []
        }
      }
    ],
    "user_message": "My user is not authorized to do something in AWS.",
    "user_facts": {
      "principal": [
        "intern-9",
        "user erin"
      ],
      "iam_action": "dynamodb:PutItem"
    },
    "intents": [
      "iam_access_denied",
      "iam_policy_problem"
    ],
    "expected_tools": [
      [
        "iam_check_permission"
      ]
    ],
    "expected_identifiers": {
      "iam_user": "erin",
      "iam_action": "dynamodb:PutItem"
    },
    "expected_root_causes": [
      "IAM_PERMISSION_MISSING"
    ],
    "expected_resolution": "GRANT_IAM_PERMISSION"
  },
  {
    "scenario_id": "CONV-LAMBDA-FIX",
    "service": "lambda",
    "variation": "missing_details",
    "fixture": [
      {
        "name": "iam_principal",
        "handle": "role",
        "params": {
          "kind": "role",
          "name": "pdf-builder-role",
          "allow": [
            "logs:*"
          ]
        }
      },
      {
        "name": "lambda_function",
        "handle": "fn",
        "params": {
          "name": "pdf-builder",
          "role_arn": "{role.arn}",
          "timeout": 3,
          "log_lines": [
            "START RequestId: 7c1f Version: $LATEST",
            "Processing batch",
            "2026-10-01T10:00:03.004Z 7c1f Task timed out after 3.00 seconds",
            "END RequestId: 7c1f"
          ],
          "invocations": 10,
          "errors": 10
        }
      }
    ],
    "user_message": "My lambda keeps timing out.",
    "user_facts": {
      "function": "pdf-builder",
      "timeout_seconds": "60"
    },
    "confirm_via": "button",
    "intents": [
      "lambda_timeout",
      "lambda_invocation_failure"
    ],
    "expected_tools": [
      [
        "lambda_get_function_logs"
      ],
      [
        "lambda_get_function_configuration"
      ]
    ],
    "expected_identifiers": {
      "function_name": "pdf-builder"
    },
    "expected_root_causes": [
      "LAMBDA_TIMEOUT_TOO_LOW"
    ],
    "expected_resolution": "INCREASE_LAMBDA_TIMEOUT",
    "post_condition": {
      "type": "lambda_timeout",
      "function_name": "{fn.name}",
      "seconds": 60
    }
  },
