            80,
            443
          ]
        }
      }
    ],
    "user_message": "I can't SSH into my EC2 server.",
    "user_facts": {
      "instance": "batch-03",
      "protocol": "ssh",
      "source_cidr": "203.0.113.10"
    },
    "intents": [
      "ec2_connectivity",
      "ec2_security_group"
    ],
    "expected_tools": [
      [
        "ec2_get_instance",
        "ec2_get_instance_status",
        "ec2_list_instances"
      ],
      [
        "ec2_get_security_group_rules"
      ]
