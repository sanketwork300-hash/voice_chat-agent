    "expected_resolution": "ADD_INGRESS_RULE",
    "post_condition": {
      "type": "ingress_rule",
      "group_id": "{vm.group_id}",
      "port": 22,
      "cidr": "203.0.113.10/32",
      "present": true
    }
  },
