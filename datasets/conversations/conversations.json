[
  {
    "scenario_id": "CONV-VAGUE",
    "service": "ec2",
    "variation": "vague",
    "fixture": [
      {
        "name": "ec2_instance",
        "handle": "vm",
        "params": {
          "name": "worker-04",
          "state": "stopped",
          "open_ports": [
            22,
            80
          ]
        }
      }
    ],
    "user_message": "My instance seems to be dead.",
    "user_facts": {
      "instance": "worker-04",
      "protocol": "ssh"
    },
    "confirm_via": "button",
    "intents": [
      "ec2_instance_down",
      "ec2_connectivity"
    ],
    "expected_tools": [
      [
        "ec2_get_instance",
        "ec2_get_instance_status",
        "ec2_list_instances"
      ]
    ],
    "expected_identifiers": {
      "instance_id": "{vm.instance_id}"
    },
    "expected_root_causes": [
      "EC2_INSTANCE_STOPPED"
    ],
    "expected_resolution": "START_INSTANCE",
    "post_condition": {
      "type": "instance_state",
      "instance_id": "{vm.instance_id}",
      "states": [
        "running",
        "pending"
      ]
    }
  },
  {
    "scenario_id": "CONV-MISSING-DETAILS",
    "service": "ec2",
    "variation": "missing_details",
    "fixture": [
      {
        "name": "ec2_instance",
        "handle": "vm",
        "params": {
