LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_FALLBACK_MODEL=qwen3:1.7b
LLM_BASE_URL=http://localhost:11434
# Only for LLM_PROVIDER=openai-compatible or nvidia; LLM_BASE_URL then includes /v1
# LLM_API_KEY=
LLM_NUM_CTX=4096

STT_PROVIDER=faster-whisper
STT_MODEL=small
STT_COMPUTE_TYPE=int8
# CPU threads for transcription; 0 means half the cores, leaving the rest for the audio loop
STT_THREADS=0

TTS_PROVIDER=piper
TTS_VOICE=en_US-lessac-medium
PIPER_CACHE_DIR=~/.cache/pipecat/piper
# 0 skips loading Whisper at startup (about 1 GB of RAM); voice calls are then unavailable
VOICE_ENABLED=1

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=~/.cache/fastembed
# Chunks given to the model per documentation answer
RAG_TOP_K=3
# Similarity below which a chunk is not treated as relevant (0 to 1). Tuned for bge-small; see docs/PROGRESS.md
RAG_MIN_SCORE=0.74

# memory:// runs without Postgres; conversations and the audit log are then lost on restart
DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support

AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
# Keys starting with "test" bypass FakeCloud IAM enforcement (admin access).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010
FRONTEND_ORIGIN=http://localhost:3000

LIGHTWEIGHT=0
DEBUG_UI=1
